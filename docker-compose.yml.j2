version: '3.8'

services:
  app:
    image: python:3.11-slim
    container_name: xff_app
    working_dir: /app
    volumes:
      - {{ project_dir }}/app:/app
    command: >
      sh -c "pip install flask && python app.py"
    networks:
      - {{ network_name }}
    ports:
      - "{{ app_host_port }}:5000"

{% for nginx in nginx_servers %}
  {{ nginx.name }}:
    image: nginx:alpine
    container_name: {{ nginx.name }}
    volumes:
      - {{ project_dir }}/nginx_configs/{{ nginx.name }}.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - {{ network_name }}
    ports:
      - "{{ nginx.host_port }}:80"
    depends_on:
      {% if nginx.upstream.startswith('nginx') %}
      - {{ nginx.upstream.split(':')[0] }}
      {% else %}
      - app
      {% endif %}
{% endfor %}

networks:
  {{ network_name }}:
    driver: bridge